#
# Bridges the 1Password SSH agent from a Parallels macOS host into this guest.
#
# The other half of this lives in shell/bash_profile, which points
# SSH_AUTH_SOCK at ~/.1password-agent.sock when the host listener is
# reachable. Without this unit running, that variable points at nothing
# and every ssh command fails with "Connection refused".
#
# On the Mac side, 1Password must be exposing its agent socket on
# 10.211.55.2:2222 (the Parallels shared-network gateway address).
#
# unlink-early matters: socat's UNIX-LISTEN refuses to bind if the socket
# file already exists, and a suspended/killed VM leaves one behind. Without
# it the service wedges into a permanent Restart=always crash loop that can
# only be cleared by deleting the stale socket by hand.
#
[Unit]
Description=1Password SSH Agent Bridge
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/socat UNIX-LISTEN:%h/.1password-agent.sock,fork,reuseaddr,unlink-early TCP:10.211.55.2:2222
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
