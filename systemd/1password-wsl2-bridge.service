#
# Bridges the Windows 1Password SSH agent into WSL2 as a Unix socket.
#
# 1Password on Windows listens only on the named pipe
# \\.\pipe\openssh-ssh-agent. npiperelay.exe (winget install
# albertony.npiperelay) connects to that pipe, and socat serves it as
# ~/.1password/agent.sock, which shell/bash_profile exports as SSH_AUTH_SOCK
# and DDEV uses as ssh_agent_upstream.
#
# systemd units don't get the Windows PATH, so link.sh symlinks npiperelay.exe
# into ~/bin. The socket lives in its own directory because DDEV mounts the
# socket's directory into its ddev-ssh-agent container.
#
[Unit]
Description=1Password SSH Agent Bridge (Windows named pipe)

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p -m 700 %h/.1password
ExecStart=/usr/bin/socat UNIX-LISTEN:%h/.1password/agent.sock,fork,unlink-early EXEC:"%h/bin/npiperelay.exe -ei -s //./pipe/openssh-ssh-agent",nofork
Restart=on-failure
RestartSec=3
# socat exits 143 on SIGTERM, which is a normal stop
SuccessExitStatus=143

[Install]
WantedBy=default.target
