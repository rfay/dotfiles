[user]
	name = Randy Fay
	email = randy@randyfay.com
	mail = randy@randyfay.com

[core]
	editor = vim
	autocrlf = false
	excludesfile = ~/.gitignore
	filemode = true
	eol = lf
	# for WSL2
	#sshCommand = ssh.exe

[push]
	default = tracking
	autoSetupRemote = true
	autoSetupRemote = true
[color]
	status = auto
	branch = auto
	interactive = auto
	diff = auto
[merge]
        keepBackup = false
	tool = p4merge
[diff]
	tool = goland
	renameLimit = 10909
[difftool]
; This setting is optional, but prevents an annoying prompt between diffing files.
	prompt = false
[difftool "goland"]
; Putting this path here doesn't work. I would love to know why.
	cmd = /Applications/Goland.app/Contents/MacOS/goland diff $(cd $(dirname $LOCAL) && pwd)/$(basename $LOCAL) $(cd $(dirname $REMOTE) && pwd)/$(basename $REMOTE)
	trustExitCode = true
	keepTemporaries = false
	keepBackup = false
[mergetool "goland"]
	cmd = /Applications/Goland.app/Contents/MacOS/goland merge $(cd $(dirname $LOCAL) && pwd)/$(basename $LOCAL) $(cd $(dirname $REMOTE) && pwd)/$(basename $REMOTE) $(cd $(dirname $BASE) && pwd)/$(basename $BASE) $(cd $(dirname $MERGED) && pwd)/$(basename $MERGED)
	trustExitCode = true
	keepTemporaries = false
	keepBackup = false


[mergetool "p4merge"]
	cmd = p4merge -le unix $BASE $LOCAL $REMOTE $MERGED
	keepTemporaries = false
	trustExitCode = false
	keepBackup = false
[status]
	submoduleSummary = true
[fetch]
	recurseSubmodules = on-demand
[hub]
	protocol = ssh
[filesystem "Oracle Corporation|13.0.1|/dev/disk1s5"]
	timestampResolution = 10000 nanoseconds
	minRacyThreshold = 0 nanoseconds
[init]
	defaultBranch = main
[pull]
	rebase = true
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[user]
  signingkey = ssh-rsa 

[gpg]
  format = ssh

[gpg "ssh"]
  program = "op-ssh-sign"

[commit]
  gpgsign = true


[rerere]
	enabled = true
[safe]
	directory =
# On plain Linux, GIT_CONFIG_GLOBAL is not set and repos live under /home/.
# WSL2 sets GIT_CONFIG_GLOBAL=~/.gitconfig-wsl2 (via .bash_profile), so it
# never reads this file and the includeIf below won't fire there.
# macOS repos live under /Users/, so it also won't fire there.
[includeIf "gitdir:/home/"]
	path = ~/.gitconfig.linux

[include]
	path = ~/.gitconfig.local
