# Detect WSL2 from the kernel, because login(1) shells, including the one WSL
# opens at startup, don't inherit WSL_DISTRO_NAME.
is_wsl=""
grep -qsi microsoft /proc/version && is_wsl=1

if [ -n "$is_wsl" ]; then
  export GIT_CONFIG_GLOBAL="$HOME/.gitconfig-wsl2"
fi

