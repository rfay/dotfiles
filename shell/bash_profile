# Windows support; doesn't matter except there
export MSYS=winsymlinks:nativestrict
# Claude Code (a native Windows process) needs a Windows path to Git's bash.exe
if command -v cygpath >/dev/null 2>&1; then
  export CLAUDE_CODE_GIT_BASH_PATH="$(cygpath -w /)bin\\bash.exe"
fi

export GOTEST_SHORT=12
export DOCKER_SCAN_SUGGEST=false
export DOCKER_SCOUT_SUGGEST=false
export HOMEBREW_NO_ASK=true

# Set PATH before sourcing ~/.bashrc below, since it looks up tools (e.g. ddev) on PATH for completions
export GOPATH=$HOME/go
export PATH=/usr/local/bin:/usr/local/sbin:$HOME/bin:$PATH:$GOPATH/bin

# git-bash: 1Password's SSH agent is a Windows named pipe that only Windows
# OpenSSH can talk to, so put it ahead of git-bash's bundled ssh. git itself
# is pointed at it via core.sshCommand in ~/.gitconfig.local (see link.sh).
case "$OSTYPE" in
  msys|cygwin)
    [ -x /c/Windows/System32/OpenSSH/ssh.exe ] && export PATH="/c/Windows/System32/OpenSSH:$PATH"
    ;;
esac

if [ -f /usr/share/bash-completion/bash_completion ]; then  . /usr/share/bash-completion/bash_completion; fi

[ -d /home/linuxbrew/.linuxbrew/bin ] && export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
[ -d /opt/homebrew/bin ] && export PATH="/opt/homebrew/bin:$PATH"

# Homebrew setup, should work for homebrew on macOs or Linux
if command -v brew >/dev/null 2>&1 ; then
  # Linuxbrew and homebrew bash completion additions
  [[ -r "$(brew --prefix)/etc/profile.d/bash_completion.sh" ]] && source "$(brew --prefix)/etc/profile.d/bash_completion.sh"
fi

[ -r "$HOME/.bashrc" ] && source "$HOME/.bashrc"

#source ~/kube-prompt.sh

# autojump is like 'z'
[ -f /usr/local/etc/profile.d/autojump.sh ] && . /usr/local/etc/profile.d/autojump.sh
[ -f /opt/homebrew/etc/profile.d/autojump.sh ] && . /opt/homebrew/etc/profile.d/autojump.sh
[ -f /usr/share/autojump/autojump.sh ] && . /usr/share/autojump/autojump.sh

# For macOS, silence deprecation warning
export BASH_SILENCE_DEPRECATION_WARNING=1

export GOTEST_SHORT=true

# Add private things that can't be in here
[ -r "$HOME/.shell-extra" ] && source "$HOME/.shell-extra"

