# Example secrets file for ~/.bash_secrets
# Copy this to ~/.bash_secrets and fill in your actual tokens
# This file is NOT committed to git

export GITHUB_PERSONAL_ACCESS_TOKEN="ghp_your_token_here"
export UPSUN_API_TOKEN="your_upsun_token_here"
# Read-only; lets the bk CLI fetch Buildkite logs (claude/skills/ci-failure)
export BUILDKITE_API_TOKEN="bkua_your_token_here"

# Add other secrets here (AWS, API keys, etc.)