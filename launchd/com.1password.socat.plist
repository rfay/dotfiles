<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac half of the Parallels 1Password bridge: serves 1Password's agent on
     the Parallels shared-network host address, where the guest's
     systemd/1password-bridge.service connects. Run through sh so $HOME and
     the Homebrew prefix aren't hardcoded. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.1password.socat</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>PATH=/opt/homebrew/bin:/usr/local/bin:$PATH exec socat TCP-LISTEN:2222,bind=10.211.55.2,fork,reuseaddr "UNIX-CONNECT:$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
